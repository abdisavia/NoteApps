generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model category {
  id         Int      @id @default(autoincrement())
  name       String   @unique(map: "Category_name_key")
  createdAt  DateTime @default(now())
  lastEdited DateTime
  noteId     Int      @unique(map: "Category_noteId_key")
  userId     Int
  user       user     @relation(fields: [userId], references: [id], map: "Category_userId_fkey")
  notes      notes?

  @@index([userId], map: "Category_userId_fkey")
}

model notes {
  title      String
  content    String   @db.LongText
  createdAt  DateTime @default(now())
  editedAt   DateTime
  userId     Int      @unique(map: "Notes_userId_key")
  categoryId Int      @unique(map: "Notes_categoryId_key")
  category   category @relation(fields: [categoryId], references: [id], map: "Notes_categoryId_fkey")
  user       user     @relation(fields: [userId], references: [id], map: "Notes_userId_fkey")
}

model user {
  id        Int        @id @default(autoincrement())
  email     String     @unique(map: "User_email_key")
  username  String     @unique(map: "User_username_key")
  password  String     @unique(map: "User_password_key")
  createdAt DateTime   @default(now())
  category  category[]
  notes     notes?
}
